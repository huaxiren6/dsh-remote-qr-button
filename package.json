{
  "name": "dsh-remote-qr-button",
  "version": "0.2.4",
  "description": "Floating phone-pairing QR button for the DSH WebUI. Companion UI for dsh-remote-link: opens its /qr pairing page in an in-app overlay.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "remote",
    "qr",
    "phone",
    "pairing"
  ],
  "author": "huaxiren6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huaxiren6/dsh-remote-qr-button.git"
  },
  "homepage": "https://github.com/huaxiren6/dsh-remote-qr-button#readme",
  "engines": {
    "node": ">=22.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "dsh-remote-link": ">=0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
